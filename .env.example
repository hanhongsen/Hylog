# ========================================
# Hylog 项目配置文件模板
# ========================================
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 填写你的实际配置值
# 3. .env 文件不会被上传到 Git（已在 .gitignore 中配置）
# ========================================

# ----------------------------------------
# 智谱 AI API 配置（推荐）
# ----------------------------------------
# 智谱 AI API Key（从 https://open.bigmodel.cn/ 获取）
ZHIPU_API_KEY=your-zhipu-api-key-here

# 智谱 AI API 地址（默认值，一般不需要修改）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# 智谱 AI 模型名称（默认值，可选 glm-4、glm-3-turbo 等）
ZHIPU_MODEL=glm-4

# ----------------------------------------
# DeepSeek API 配置（可选）
# ----------------------------------------
# DeepSeek API Key（从 https://platform.deepseek.com/ 获取）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# DeepSeek API 地址（默认值，一般不需要修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名称（默认值，一般不需要修改）
DEEPSEEK_MODEL=deepseek-chat

# ----------------------------------------
# OpenAI API 配置（可选）
# ----------------------------------------
# OpenAI API Key（从 https://platform.openai.com/ 获取）
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI API 地址（默认值，使用代理时可能需要修改）
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI 模型名称（默认值，可选 gpt-3.5-turbo、gpt-4 等）
OPENAI_MODEL=gpt-3.5-turbo

# ----------------------------------------
# LLM 调用参数配置
# ----------------------------------------
# 温度参数（0-1，值越大回答越随机，默认 0.7）
LLM_TEMPERATURE=0.7

# 最大 token 数量（默认 2000）
LLM_MAX_TOKENS=2000

# 请求超时时间（秒，默认 60）
LLM_TIMEOUT=60

# ----------------------------------------
# 成本控制配置
# ----------------------------------------
# 每日消费上限（元，默认 10）
DAILY_COST_LIMIT=10

# 每月消费上限（元，默认 200）
MONTHLY_COST_LIMIT=200

# ----------------------------------------
# 日志配置
# ----------------------------------------
# 日志级别（DEBUG、INFO、WARNING、ERROR、CRITICAL，默认 INFO）
LOG_LEVEL=INFO

# 日志保留天数（默认 30）
LOG_RETENTION_DAYS=30

# 单个日志文件最大大小（MB，默认 10）
LOG_MAX_SIZE_MB=10
